  "modes": [
    {
      "query": "body.density-compact",
      "tokens": {
        "control-height": "34px"
      }
    },
    {
      "media": "(max-width:1100px)",
      "query": ":root",
      "tokens": {
        "page-gutter": "24px"
      }
    },
    {
      "media": "(max-width:700px)",
      "query": ":root",
      "tokens": {
        "page-gutter": "16px",
        "panel-padding": "16px"
      }
    },
    {
      "media": "(pointer:coarse)",
      "query": "body,body.density-compact",
      "tokens": {
        "control-height": "44px",
        "icon-target": "44px"
      }
    }
  ],
  "breakpoints": {
    "tablet": "(max-width:1100px)",
    "phone": "(max-width:700px)",
    "small": "(max-width:560px)"
  }
}
