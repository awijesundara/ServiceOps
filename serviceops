#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
ServiceOps lifecycle command

Installation:
  ./serviceops install web
  ./serviceops install server [--mode bundled|external ...]
  ./serviceops install kubernetes [--preflight]

Operations:
  ./serviceops start | stop | restart | status | health | logs | doctor
  ./serviceops deploy-local | install-update-hook
  ./serviceops backup [NAME]
  ./serviceops restore DATABASE_DUMP
  ./serviceops rehearse-recovery [MANIFEST]
  ./serviceops rehearse-pitr
  ./serviceops rehearse-migrations [ROW_COUNT]
  ./serviceops rehearse-upgrade
  ./serviceops diagnose-recovery
  ./serviceops stability-probe [REQUESTS]
  ./serviceops recover-admin USERNAME
  ./serviceops recover-audit-key TENANT_SLUG
  ./serviceops retire-bootstrap-secret
  ./serviceops update [IMAGE_REF] | update kubernetes [IMAGE_TAG] | config
  ./serviceops bootstrap-blue-green          (one-time: convert to the zero-downtime topology)
  ./serviceops deploy IMAGE_REF | rollback   (DEPLOYMENT_MODE=blue-green only -- zero-downtime)
EOF
}

command="${1:-}"
if [[ "$command" == "install" ]]; then
  target="${2:-web}"
  shift 2 || true
  case "$target" in
    web) exec "$ROOT_DIR/tools/install/web.sh" "$@" ;;
    server) exec "$ROOT_DIR/tools/install/server.sh" "$@" ;;
    kubernetes|k8s) exec "$ROOT_DIR/tools/install/kubernetes.sh" "$@" ;;
    *) echo "Unknown installation target: $target" >&2; usage; exit 2 ;;
  esac
fi
if [[ "$command" == "update" && ( "${2:-}" == "kubernetes" || "${2:-}" == "k8s" ) ]]; then
  exec "$ROOT_DIR/tools/safe_update_k8s.sh" "${3:-}"
fi
if [[ "$command" == "deploy-local" ]]; then
  exec "$ROOT_DIR/tools/deploy-local.sh"
fi
if [[ "$command" == "bootstrap-blue-green" ]]; then
  exec "$ROOT_DIR/tools/blue_green_bootstrap.sh"
fi
if [[ "$command" == "install-update-hook" ]]; then
  git -C "$ROOT_DIR" config core.hooksPath .githooks
  chmod +x "$ROOT_DIR/.githooks/post-merge" "$ROOT_DIR/tools/deploy-local.sh"
  echo "Installed the ServiceOps post-merge Docker redeploy hook."
  exit 0
fi
[[ "$command" == "help" || "$command" == "--help" || "$command" == "-h" || -z "$command" ]] && {
  usage
  exit 0
}

ENV_FILE="$ROOT_DIR/.env"
[[ -f "$ENV_FILE" ]] || {
  echo "ServiceOps is not installed. Run ./serviceops install web" >&2
  exit 1
}

# .env is later `source`d directly as bash (several commands below do
# `set -a; source "$ENV_FILE"; set +a`), not parsed as plain key=value pairs.
# A value containing shell-special characters (&, #, (, ), {, }, spaces, ...)
# left unquoted breaks that `source` with a cryptic "syntax error near
# unexpected token" pointing at a line number with no explanation. Catch it
# here with an actionable message instead.
validate_env_file() {
  local file="$1" line_num=0 key value bad=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_num=$((line_num + 1))
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    [[ -z "$value" ]] && continue
    [[ "$value" == \"*\" || "$value" == \'*\' ]] && continue
    if [[ "$value" =~ [\&\#\(\)\;\|\<\>\$\'\`[:space:]] ]]; then
      echo "✗ $file line $line_num: ${key}'s value contains a shell-special character (this file is sourced by bash) and must be double-quoted." >&2
      echo "  Change it to: ${key}=\"${value}\"" >&2
      bad=1
    fi
  done <"$file"
  [[ "$bad" -eq 0 ]] || { echo "Fix the line(s) above, then retry." >&2; exit 2; }
}
validate_env_file "$ENV_FILE"

MODE="$(awk -F= '/^DEPLOYMENT_MODE=/{value=$2; gsub(/^[[:space:]"]+|[[:space:]"]+$/, "", value); print value}' "$ENV_FILE" | tail -1)"
if [[ "$MODE" == "external" ]]; then
  FILE="$ROOT_DIR/compose.external-db.yaml"
elif [[ "$MODE" == "blue-green" ]]; then
  FILE="$ROOT_DIR/compose.blue-green.yaml"
else
  FILE="$ROOT_DIR/compose.yaml"
fi
COMPOSE=(docker compose --env-file "$ENV_FILE" -f "$FILE")
BACKUP_DIR="$ROOT_DIR/backups"
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

case "$command" in
  start) "${COMPOSE[@]}" up -d --remove-orphans ;;
  stop) "${COMPOSE[@]}" stop ;;
  restart) "${COMPOSE[@]}" restart; "$0" health ;;
  status) "${COMPOSE[@]}" ps ;;
  logs) "${COMPOSE[@]}" logs -f --tail=200 app ;;
  health)
    port="$(awk -F= '/^APP_PORT=/{value=$2; gsub(/^[[:space:]"]+|[[:space:]"]+$/, "", value); print value}' "$ENV_FILE" | tail -1)"
    curl -fsS "http://127.0.0.1:${port:-8080}/health"
    printf "\nhealthy\n"
    ;;
  config) "${COMPOSE[@]}" config ;;
  doctor)
    failures=0
    echo "ServiceOps diagnostics"
    docker info >/dev/null 2>&1 && echo "✓ Docker daemon" || { echo "✗ Docker daemon"; failures=$((failures+1)); }
    "${COMPOSE[@]}" config --quiet && echo "✓ Compose configuration" || { echo "✗ Compose configuration"; failures=$((failures+1)); }
    "${COMPOSE[@]}" ps
    "$0" health >/dev/null 2>&1 && echo "✓ Application health" || { echo "✗ Application health"; failures=$((failures+1)); }
    "${COMPOSE[@]}" exec -T app python -c "from app import create_app,db; from sqlalchemy import text; a=create_app(); c=a.app_context(); c.push(); db.session.execute(text('SELECT 1')); print('✓ Database query')" 2>/dev/null || { echo "✗ Database query"; failures=$((failures+1)); }
    "${COMPOSE[@]}" exec -T app sh -c 'test -w /app/uploads' && echo "✓ Upload persistence" || { echo "✗ Upload persistence"; failures=$((failures+1)); }
    "${COMPOSE[@]}" exec -T worker sh -c 'test -z "${ADMIN_PASSWORD:-}" && test -z "${ADMIN_PASSWORD_FILE:-}"' \
      && echo "✓ Worker excludes bootstrap administrator secret" \
      || { echo "✗ Worker contains bootstrap administrator secret"; failures=$((failures+1)); }
    exit "$failures"
    ;;
  retire-bootstrap-secret)
    "${COMPOSE[@]}" exec -T app python -c "from app import create_app,User; a=create_app(); c=a.app_context(); c.push(); assert User.query.filter_by(role='admin',active=True).count() > 0, 'No active administrator exists'; print('Active administrator verified')"
    read -r -p "Confirm the local administrator password is stored in your vault. Type RETIRE: " answer
    [[ "$answer" == "RETIRE" ]] || { echo "Cancelled."; exit 1; }
    retired_file="$(mktemp "$ROOT_DIR/.env.retire.XXXXXX")"
    awk '
      /^ADMIN_PASSWORD=/ {print "ADMIN_PASSWORD="; next}
      /^ADMIN_PASSWORD_FILE=/ {print "ADMIN_PASSWORD_FILE="; next}
      {print}
    ' "$ENV_FILE" >"$retired_file"
    chmod 600 "$retired_file"
    mv "$retired_file" "$ENV_FILE"
    "${COMPOSE[@]}" up -d --force-recreate --remove-orphans app worker
    "$0" health
    "${COMPOSE[@]}" exec -T app sh -c 'test -z "${ADMIN_PASSWORD:-}" && test -z "${ADMIN_PASSWORD_FILE:-}"'
    echo "Bootstrap administrator secret retired from the steady-state containers."
    ;;
  backup)
    [[ "$MODE" == "bundled" || "$MODE" == "blue-green" ]] || { echo "External database mode: use the database provider backup service."; exit 2; }
    stamp="${2:-$(date -u +%Y%m%dT%H%M%SZ)}"
    dump="$BACKUP_DIR/serviceops-$stamp.dump"
    uploads="$BACKUP_DIR/serviceops-uploads-$stamp.tar.gz"
    manifest="$BACKUP_DIR/serviceops-$stamp.manifest.json"
    started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    set -a; source "$ENV_FILE"; set +a
    "${COMPOSE[@]}" exec -T db pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --format=custom >"$dump"
    docker run --rm -v serviceops_uploads:/data:ro -v "$BACKUP_DIR":/backup alpine:3.21 \
      tar -czf "/backup/$(basename "$uploads")" -C /data .
    completed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    key_reference="$(python3 -c 'import hashlib,os; print("sha256:" + hashlib.sha256(os.environ["SETTINGS_ENCRYPTION_KEY"].encode()).hexdigest()[:16])')"
    python3 "$ROOT_DIR/tools/recovery_verify.py" create-manifest \
      --database "$dump" --uploads "$uploads" --output "$manifest" \
      --started-at "$started_at" --completed-at "$completed_at" \
      --application-image "${SERVICEOPS_IMAGE:-unknown}" --key-reference "$key_reference"
    chmod 600 "$dump" "$uploads" "$manifest"
    echo "Database: $dump"
    echo "Uploads:  $uploads"
    echo "Manifest: $manifest"
    offsite_status="not-configured"
    if [[ -n "${BACKUP_ARCHIVE_BUCKET:-}" ]]; then
      docker run --rm --env-file "$ENV_FILE" -v "$BACKUP_DIR:/recovery:ro" \
        "${SERVICEOPS_IMAGE}" python -m tools.archive_recovery_set "/recovery/$(basename "$manifest")"
      offsite_status="archived"
    fi
    if "${COMPOSE[@]}" exec -T app test -f tools/record_backup_status.py; then
      "${COMPOSE[@]}" exec -T app python -m tools.record_backup_status \
        --manifest "$(basename "$manifest")" --offsite "$offsite_status"
    else
      echo "Backup succeeded; deploy 1.39.0 before recording dashboard status." >&2
    fi
    ;;
  restore)
    [[ "$MODE" == "bundled" || "$MODE" == "blue-green" ]] || { echo "Restore is managed by the external database provider."; exit 2; }
    dump="${2:-}"; [[ -f "$dump" ]] || { echo "Provide a valid database dump."; exit 2; }
    read -r -p "This replaces the ServiceOps database. Type RESTORE: " answer
    [[ "$answer" == "RESTORE" ]] || { echo "Cancelled."; exit 1; }
    set -a; source "$ENV_FILE"; set +a
    if [[ "$MODE" == "blue-green" ]]; then
      restore_app_services=(app_blue app_green)
    else
      restore_app_services=(app)
    fi
    "${COMPOSE[@]}" stop "${restore_app_services[@]}" worker
    "${COMPOSE[@]}" exec -T db pg_restore -U "$POSTGRES_USER" -d "$POSTGRES_DB" --clean --if-exists --no-owner <"$dump"
    "${COMPOSE[@]}" start "${restore_app_services[@]}" worker
    "$0" health
    ;;
  rehearse-recovery)
    exec "$ROOT_DIR/tools/rehearse-recovery.sh" "${2:-}"
    ;;
  rehearse-pitr)
    exec "$ROOT_DIR/tools/rehearse-pitr.sh"
    ;;
  rehearse-migrations)
    exec "$ROOT_DIR/tools/rehearse-postgres-migrations.sh" "${2:-100000}"
    ;;
  rehearse-upgrade)
    exec "$ROOT_DIR/tools/rehearse-upgrade.sh"
    ;;
  diagnose-recovery)
    "${COMPOSE[@]}" exec -T app python -m tools.admin_recovery diagnose
    ;;
  stability-probe)
    port="$(awk -F= '/^APP_PORT=/{value=$2; gsub(/^[[:space:]\"]+|[[:space:]\"]+$/, "", value); print value}' "$ENV_FILE" | tail -1)"
    python3 "$ROOT_DIR/tools/stability_probe.py" --url "http://127.0.0.1:${port:-8080}/health" \
      --requests "${2:-500}"
    ;;
  recover-admin)
    username="${2:-}"; [[ -n "$username" ]] || { echo "Provide the administrator username." >&2; exit 2; }
    "$0" backup "pre-admin-recovery-$(date -u +%Y%m%dT%H%M%SZ)"
    read -r -s -p "New administrator password: " recovery_password; echo
    printf '%s\n' "$recovery_password" | "${COMPOSE[@]}" exec -T app \
      python -m tools.admin_recovery reset-admin --username "$username" --confirm
    unset recovery_password
    ;;
  recover-audit-key)
    tenant_slug="${2:-}"; [[ -n "$tenant_slug" ]] || { echo "Provide the tenant slug." >&2; exit 2; }
    "$0" backup "pre-audit-key-recovery-$(date -u +%Y%m%dT%H%M%SZ)"
    read -r -p "This establishes a permanent audit recovery boundary. Type RECOVER-AUDIT: " answer
    [[ "$answer" == "RECOVER-AUDIT" ]] || { echo "Cancelled."; exit 1; }
    "${COMPOSE[@]}" exec -T app python -m tools.admin_recovery recover-audit-key \
      --tenant "$tenant_slug" --confirm
    ;;
  update)
    exec "$ROOT_DIR/tools/safe_update.sh" "${2:-}"
    ;;
  deploy)
    [[ "$MODE" == "blue-green" ]] || {
      echo "deploy requires DEPLOYMENT_MODE=blue-green in .env (zero-downtime blue/green rollout)." >&2
      echo "For the default single-instance topology, use: ./serviceops update [IMAGE_REF]" >&2
      exit 2
    }
    exec "$ROOT_DIR/tools/blue_green_deploy.sh" "${2:?Usage: ./serviceops deploy <image>}"
    ;;
  rollback)
    [[ "$MODE" == "blue-green" ]] || {
      echo "rollback requires DEPLOYMENT_MODE=blue-green in .env." >&2
      exit 2
    }
    exec "$ROOT_DIR/tools/blue_green_rollback.sh"
    ;;
  *) usage; exit 2 ;;
esac
