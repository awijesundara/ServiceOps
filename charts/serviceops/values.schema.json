{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["replicaCount", "image", "deploymentProfile", "database", "existingSecret", "existingBootstrapSecret", "healthTest"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "deploymentProfile": {"type": "string", "const": "production"},
    "existingSecret": {"type": "string", "minLength": 1},
    "existingBootstrapSecret": {"type": "string", "minLength": 1},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "database": {
      "type": "object",
      "required": ["mode", "readinessTimeoutSeconds"],
      "properties": {
        "mode": {"type": "string", "const": "external"},
        "readinessTimeoutSeconds": {"type": "integer", "minimum": 30, "maximum": 3600},
        "backupReference": {"type": "string", "maxLength": 240}
      }
    },
    "rollingUpdate": {
      "type": "object",
      "required": ["maxUnavailable", "maxSurge", "preStopDelaySeconds"],
      "properties": {
        "maxUnavailable": {"type": ["integer", "string"]},
        "maxSurge": {"type": ["integer", "string"]},
        "preStopDelaySeconds": {"type": "integer", "minimum": 0, "maximum": 300}
      }
    },
    "progressiveDelivery": {
      "type": "object",
      "required": ["enabled", "steps", "prometheus"],
      "properties": {
        "enabled": {"type": "boolean"},
        "steps": {"type": "array", "minItems": 1},
        "prometheus": {
          "type": "object",
          "required": ["enabled", "address", "successCondition", "query"],
          "properties": {
            "enabled": {"type": "boolean"},
            "address": {"type": "string"},
            "successCondition": {"type": "string", "minLength": 1},
            "query": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "featureFlags": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "observability": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
            "scrapeTimeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
            "prometheusNamespaceSelector": {"type": "object"}
          }
        },
        "openTelemetry": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "instrumentation": {"type": "string"}
          }
        }
      }
    },
    "healthTest": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag", "digest"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    },
    "security": {
      "type": "object",
      "required": ["csrfEnabled", "sessionCookieSecure", "sessionLifetimeMinutes"],
      "properties": {
        "csrfEnabled": {"type": "boolean", "const": true},
        "sessionCookieSecure": {"type": "boolean"},
        "sessionLifetimeMinutes": {"type": "integer", "minimum": 5, "maximum": 1440}
      }
    }
  }
}
