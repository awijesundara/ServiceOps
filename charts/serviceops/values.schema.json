{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["replicaCount", "image", "deploymentProfile", "database", "existingSecret"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "deploymentProfile": {"type": "string", "const": "production"},
    "existingSecret": {"type": "string", "minLength": 1},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "database": {
      "type": "object",
      "required": ["mode", "readinessTimeoutSeconds"],
      "properties": {
        "mode": {"type": "string", "const": "external"},
        "readinessTimeoutSeconds": {"type": "integer", "minimum": 30, "maximum": 3600}
      }
    },
    "security": {
      "type": "object",
      "required": ["csrfEnabled", "sessionCookieSecure", "sessionLifetimeMinutes"],
      "properties": {
        "csrfEnabled": {"type": "boolean", "const": true},
        "sessionCookieSecure": {"type": "boolean"},
        "sessionLifetimeMinutes": {"type": "integer", "minimum": 5, "maximum": 1440}
      }
    }
  }
}
