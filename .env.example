# This file is loaded with `set -a; source .env; set +a` (see ./serviceops,
# tools/safe_update.sh) -- it is a real bash script, not simple key=value
# parsing. Any value containing shell-special characters (&, #, (, ), spaces,
# etc.) MUST be double-quoted, or bash will misparse or truncate it.
APP_PORT=8080
BIND_ADDRESS=127.0.0.1
DEPLOYMENT_MODE=bundled
INSTANCE_NAME=ServiceOps
COMPANY_NAME="Your Company"
BRAND_TEAL="#003e4c"
BRAND_AMBER="#f9aa3c"
# Generate a Fernet key for durable encrypted settings.
SETTINGS_ENCRYPTION_KEY=
AUDIT_INTEGRITY_KEY=
AUDIT_INTEGRITY_KEY_FILE=
API_TOKEN_PEPPER=
METRICS_ENABLED=true
METRICS_TOKEN=
# Optional S3-compatible attachment storage. Leave bucket empty for local volume storage.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Optional off-site immutable recovery archive (S3 Object Lock recommended).
BACKUP_ARCHIVE_ENDPOINT=
BACKUP_ARCHIVE_REGION=us-east-1
BACKUP_ARCHIVE_BUCKET=
BACKUP_ARCHIVE_PREFIX=serviceops
BACKUP_ARCHIVE_ACCESS_KEY=
BACKUP_ARCHIVE_SECRET_KEY=
BACKUP_ARCHIVE_KMS_KEY=
BACKUP_RETENTION_DAYS=35
BACKUP_MINIMUM_SETS=7
BACKUP_REQUIRE_OBJECT_LOCK=true
BACKUP_RPO_HOURS=24
RECOVERY_RTO_MINUTES=60
POSTGRES_DB=serviceops
POSTGRES_USER=serviceops
POSTGRES_PASSWORD=use-a-long-random-password
# External mode only:
# DATABASE_URL=postgresql+psycopg://serviceops:password@db.example.com:5432/serviceops?sslmode=require
SECRET_KEY=use-a-long-random-secret
ADMIN_PASSWORD=use-a-strong-admin-password
ADMIN_PASSWORD_FILE=
LOCAL_AUTH_ENABLED=true
CSRF_ENABLED=true
# Production defaults to secure cookies; ServiceOps refuses to start with
# insecure cookies unless ALLOW_INSECURE_SESSION_COOKIES is also set. Only set
# SESSION_COOKIE_SECURE=false with ALLOW_INSECURE_SESSION_COOKIES=true on an
# isolated plain-HTTP localhost/development deployment, never in production.
SESSION_COOKIE_SECURE=true
ALLOW_INSECURE_SESSION_COOKIES=false
SESSION_LIFETIME_MINUTES=480
AUTO_MIGRATE=true
LDAP_ENABLED=false
LDAP_SERVER_URI=ldaps://dc01.example.com:636
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=example,DC=com
LDAP_USER_FILTER="(&(objectClass=user)(sAMAccountName={username}))"
LDAP_START_TLS=true
LDAP_VALIDATE_CERT=true
LDAP_CA_CERT=
LDAP_ROLE_MAPPINGS={}
KEYCLOAK_ENABLED=false
KEYCLOAK_DISCOVERY_URL=https://sso.example.com/realms/company/.well-known/openid-configuration
KEYCLOAK_CLIENT_ID=serviceops
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ROLE_MAPPINGS={}
# When set, OIDC login is rejected unless the IdP returns this exact acr claim.
KEYCLOAK_REQUIRED_ACR=
# Passkeys require a real HTTPS relying-party domain. APPLE_PASSKEY_APP_ID is
# the Apple Team ID plus bundle ID, for example 87BH39B63Y.wijesundara.com.ServiceOps.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=ServiceOps
WEBAUTHN_ORIGIN=
APPLE_PASSKEY_APP_ID=
SERVICEOPS_IMAGE=serviceops-app:1.79.1
# Apple Push Notification service (configure in Platform settings or here)
APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=wijesundara.com.ServiceOps
APNS_PRIVATE_KEY=
