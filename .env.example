APP_PORT=8080
BIND_ADDRESS=127.0.0.1
DEPLOYMENT_MODE=bundled
INSTANCE_NAME=ServiceOps
COMPANY_NAME=Your Company
BRAND_TEAL=#003e4c
BRAND_AMBER=#f9aa3c
# Generate a Fernet key for durable encrypted settings.
SETTINGS_ENCRYPTION_KEY=
AUDIT_INTEGRITY_KEY=
AUDIT_INTEGRITY_KEY_FILE=
API_TOKEN_PEPPER=
POSTGRES_DB=serviceops
POSTGRES_USER=serviceops
POSTGRES_PASSWORD=use-a-long-random-password
# External mode only:
# DATABASE_URL=postgresql+psycopg://serviceops:password@db.example.com:5432/serviceops?sslmode=require
SECRET_KEY=use-a-long-random-secret
ADMIN_PASSWORD=use-a-strong-admin-password
ADMIN_PASSWORD_FILE=
LOCAL_AUTH_ENABLED=true
CSRF_ENABLED=true
# Production defaults to secure cookies; ServiceOps refuses to start with
# insecure cookies unless ALLOW_INSECURE_SESSION_COOKIES is also set. Only set
# SESSION_COOKIE_SECURE=false with ALLOW_INSECURE_SESSION_COOKIES=true on an
# isolated plain-HTTP localhost/development deployment, never in production.
SESSION_COOKIE_SECURE=true
ALLOW_INSECURE_SESSION_COOKIES=false
SESSION_LIFETIME_MINUTES=480
AUTO_MIGRATE=true
LDAP_ENABLED=false
LDAP_SERVER_URI=ldaps://dc01.example.com:636
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=example,DC=com
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
LDAP_START_TLS=true
LDAP_VALIDATE_CERT=true
LDAP_CA_CERT=
LDAP_ROLE_MAPPINGS={}
KEYCLOAK_ENABLED=false
KEYCLOAK_DISCOVERY_URL=https://sso.example.com/realms/company/.well-known/openid-configuration
KEYCLOAK_CLIENT_ID=serviceops
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ROLE_MAPPINGS={}
SERVICEOPS_IMAGE=serviceops-app:1.23.3
