# This file lands at /etc/nginx/conf.d/default.conf (via the nginx:1.27
# image's built-in envsubst-on-templates entrypoint step, since it's
# mounted at /etc/nginx/templates/default.conf.template) and is `include`d
# from inside the base image's own http {} block -- so this may only
# contain http-context directives (log_format, resolver, server { ... }),
# never worker_processes/events{}/http{} themselves; the base image's
# /etc/nginx/nginx.conf already provides those.

# `resolver` + a variable (not a static upstream block) for the proxy_pass
# target is what makes the active-slot switch in tools/blue_green_deploy.sh
# take effect without recreating this container: a static `upstream {}`
# block resolves DNS once at nginx startup and caches it, so cutting over
# would need a full container restart. Docker's embedded DNS is
# authoritative for compose service names, so resolving per-request here is
# cheap and correct, and a plain `nginx -s reload` (which re-reads this
# file and does pick up a changed $active_app value) is enough to switch.
resolver 127.0.0.11 valid=5s;

log_format detailed '$remote_addr - $remote_user [$time_local] '
                     '"$request" $status $body_bytes_sent '
                     '"$http_referer" "$http_user_agent" '
                     'rt=$request_time uct=$upstream_connect_time '
                     'uht=$upstream_header_time urt=$upstream_response_time '
                     'upstream=$upstream_addr';
access_log /dev/stdout detailed;
error_log /dev/stderr warn;

client_max_body_size 25m;
proxy_read_timeout 65s;
proxy_connect_timeout 10s;

server {
  listen 80;

  # ACTIVE_APP_SLOT is substituted by the entrypoint step above on
  # container start, and tools/blue_green_deploy.sh's cutover regenerates
  # this exact file with a new value (via `docker compose exec nginx sh -c
  # 'envsubst ... > default.conf && nginx -s reload'`) instead of touching
  # the container.
  set $active_app "${ACTIVE_APP_SLOT}";

  location /health {
    proxy_pass http://$active_app:8080/health;
    access_log off;
  }

  location / {
    proxy_pass http://$active_app:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }
}
