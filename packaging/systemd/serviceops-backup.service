[Unit]
Description=Create and verify a ServiceOps recovery set
Documentation=https://github.com/awijesundara/ServiceOps
After=serviceops.service
Requires=serviceops.service
ConditionPathExists=/etc/serviceops/serviceops.env

[Service]
Type=oneshot
User=serviceops
Group=serviceops
SupplementaryGroups=docker
WorkingDirectory=/opt/serviceops
Environment=HOME=/var/lib/serviceops
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/serviceops /etc/serviceops /var/lib/serviceops
ExecStart=/usr/bin/serviceops scheduled-backup
TimeoutStartSec=3600
