[Unit]
Description=ServiceOps ITSM platform (Docker Compose stack)
Documentation=https://github.com/awijesundara/ServiceOps
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/serviceops/serviceops.env

[Service]
Type=oneshot
RemainAfterExit=yes
User=serviceops
Group=serviceops
SupplementaryGroups=docker
WorkingDirectory=/opt/serviceops
Environment=HOME=/var/lib/serviceops
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/serviceops /etc/serviceops /var/lib/serviceops
ExecStartPre=/usr/bin/serviceops config-check
ExecStart=/usr/bin/serviceops start
ExecStop=/usr/bin/serviceops stop
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
